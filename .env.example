# Copiez ce fichier en .env (ne le publiez JAMAIS sur GitHub) puis remplissez les valeurs.
PORT=8787

# Adresse(s) exacte(s) de l'application autorisée(s) à appeler ce backend, séparées par des virgules.
ALLOWED_ORIGIN=https://votre-application.example.com

# Clé d'accès à CE backend (à inventer, longue et aléatoire). À saisir dans l'application, champ « Clé d'accès ».
APP_ACCESS_KEY=remplacez-par-une-longue-valeur-aleatoire

# --- Awin Publisher API ---
# Jeton généré dans Awin : Account > API Credentials
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
# Région du rapport (ex. US, GB, FR)
AWIN_REGION=US
# Facultatif : URL d'un flux produits CSV créé dans Awin (Create-a-Feed). Elle contient une clé : gardez-la ici.
AWIN_FEED_URL=

# --- Amazon Creators API ---
# Mettre true uniquement si Amazon a autorisé votre compte ET que vous avez implémenté l'appel (voir server.js).
AMAZON_CREATORS_ENABLED=false
